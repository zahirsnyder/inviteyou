// InviteYou — Prisma schema
// Production runs on PostgreSQL (Supabase). `DATABASE_URL` is the pooled
// connection used by the app at runtime; `DIRECT_URL` is the direct (non-pooled)
// connection Prisma uses for migrations. Enum-like fields are kept as String
// (constants live in src/lib/constants.ts) and theme config is a JSON string,
// so the schema stays portable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      String   @default("CUSTOMER") // ADMIN | CUSTOMER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects  WeddingProject[]
  purchases TemplatePurchase[]
}

model WeddingProject {
  id            String    @id @default(cuid())
  userId        String
  slug          String    @unique
  brideName     String
  groomName     String
  title         String?
  quote         String?
  story         String?
  weddingDate   DateTime
  isPublished   Boolean   @default(false)
  themeId       String?
  musicUrl      String?
  coverImageUrl String?
  // Gift / money: `giftDetails` = bank + account text, `giftQrUrl` = a payment
  // QR image (DuitNow, bank app, …). Each side can be toggled on the invitation.
  giftQrUrl     String?
  giftDetails   String?
  showGift      Boolean   @default(true)
  showGiftQr    Boolean   @default(true)
  // Up to two contact people for guest questions; the block can be hidden.
  contactName1  String?
  contactPhone1 String?
  contactName2  String?
  contactPhone2 String?
  showContact   Boolean   @default(true)
  maxRsvp       Int?
  rsvpDeadline  DateTime?
  // Once an invitation is first published it is "locked": the couple's identity
  // (names, date, slug) can no longer be changed — a new invitation needs a new
  // purchase. `expiresAt` is when a live invitation stops being publicly shown
  // (default: wedding date + grace period); it can be extended.
  lockedAt      DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme     Theme?            @relation(fields: [themeId], references: [id])
  events    WeddingEvent[]
  gallery   GalleryImage[]
  guests    Guest[]
  rsvps     Rsvp[]
  wishes    GuestWish[]
  analytics AnalyticsEvent[]
  purchase  TemplatePurchase?

  @@index([userId])
}

model WeddingEvent {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?
  eventDate   DateTime
  startTime   String?
  endTime     String?
  venueName   String
  address     String
  mapUrl      String? // Google Maps link
  wazeUrl     String? // Waze link
  order       Int      @default(0)

  project WeddingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Theme {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  tagline         String?
  previewUrl      String? // link to a live demo invitation
  previewImageUrl String? // card / hero artwork for the marketplace
  config          String   @default("{}") // JSON string
  isPremium       Boolean  @default(false)
  isListed        Boolean  @default(true) // show in the template marketplace
  priceCents      Int      @default(0) // 0 = free
  currency        String   @default("MYR")
  createdAt       DateTime @default(now())

  projects  WeddingProject[]
  purchases TemplatePurchase[]
}

// One purchase = the right to publish ONE invitation on a template.
// It is "unused" while `projectId` is null; creating an invitation from the
// template consumes it by binding it to that project. Building another
// invitation (any couple) needs another purchase. No payment gateway yet —
// `claimTemplateAction` mints one instantly; an admin can adjust `status`.
model TemplatePurchase {
  id          String   @id @default(cuid())
  userId      String
  themeId     String
  projectId   String?  @unique
  status      String   @default("PAID") // PENDING | PAID | REFUNDED
  amountCents Int      @default(0)
  currency    String   @default("MYR")
  createdAt   DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme   Theme           @relation(fields: [themeId], references: [id], onDelete: Cascade)
  project WeddingProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, themeId, status])
}

model GalleryImage {
  id        String  @id @default(cuid())
  projectId String
  imageUrl  String
  caption   String?
  order     Int     @default(0)

  project WeddingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Guest {
  id         String    @id @default(cuid())
  projectId  String
  name       String
  phone      String?
  email      String?
  groupName  String?
  inviteCode String    @unique @default(cuid())
  status     String    @default("INVITED") // INVITED | OPENED | RSVP_PENDING | ATTENDING | NOT_ATTENDING | MAYBE
  maxPax     Int       @default(1)
  openedAt   DateTime?
  createdAt  DateTime  @default(now())

  project WeddingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rsvp    Rsvp?

  @@index([projectId])
}

model Rsvp {
  id             String   @id @default(cuid())
  projectId      String
  guestId        String?  @unique
  name           String
  phone          String?
  attendance     String // ATTENDING | NOT_ATTENDING | MAYBE
  paxCount       Int      @default(1)
  mealPreference String? // deprecated — no longer collected; kept for old rows

  message        String?
  createdAt      DateTime @default(now())

  project WeddingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  guest   Guest?         @relation(fields: [guestId], references: [id])

  @@index([projectId])
}

model GuestWish {
  id        String   @id @default(cuid())
  projectId String
  name      String
  message   String
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())

  project WeddingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  projectId String
  eventType String // VISIT | QR_SCAN | RSVP_SUBMIT | WISH_SUBMIT
  visitorId String?
  device    String?
  referrer  String?
  metadata  String?
  createdAt DateTime @default(now())

  project WeddingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Payment {
  id          String   @id @default(cuid())
  userId      String
  projectId   String?
  amount      Decimal
  currency    String   @default("MYR")
  status      String   @default("PENDING") // PENDING | PAID | FAILED | REFUNDED | EXPIRED
  provider    String
  providerRef String?
  createdAt   DateTime @default(now())
}
