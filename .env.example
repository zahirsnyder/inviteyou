# InviteYou — environment variables

# --- Database (PostgreSQL / Supabase) ---
# Both use the Supabase POOLER host (aws-0-<region>.pooler.supabase.com), which is
# reachable over IPv4. Do NOT use db.<ref>.supabase.co — that direct host is
# IPv6-only and fails from IPv4-only build servers like Netlify.
#   DATABASE_URL: transaction pooler, port 6543, ?pgbouncer=true — app runtime.
#   DIRECT_URL:   session pooler,     port 5432, no pgbouncer   — Prisma migrations.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth ---
# Long random string used to sign session cookies, e.g. `openssl rand -hex 32`.
SESSION_SECRET=""

# --- App ---
# Public base URL. Locally http://localhost:3000; in production your Netlify domain.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Future integrations (not required yet) ---
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""
RESEND_API_KEY=""
PAYMENT_PROVIDER_SECRET=""
