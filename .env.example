# SQLite for local dev. For PostgreSQL use e.g.
# DATABASE_URL="postgresql://user:password@localhost:5432/inviteyou"
# (also change datasource provider in prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies (generate a long random string)
SESSION_SECRET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Future integrations (not required for MVP)
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""
RESEND_API_KEY=""
PAYMENT_PROVIDER_SECRET=""
